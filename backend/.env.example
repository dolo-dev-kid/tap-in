# Copy to backend/.env and fill in your own values. Never commit .env.
# MongoDB Atlas (create a free cluster at mongodb.com, or use a local MongoDB):
# mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tap-in
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
